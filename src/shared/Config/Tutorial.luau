	ReadSeconds = 12, -- วินาที: ขั้น 5 ผ่านเองเมื่อครบ
	MinReadSeconds = 2, -- วินาที: ขั้น 5 ต้องเห็นอย่างน้อยเท่านี้ก่อนกด "เข้าใจแล้ว!" ได้
	MaxBossHold = 60, -- วินาที: เลื่อนบอสได้สูงสุดเท่านี้ ระหว่างมีคนอยู่ขั้นมอนฝึก (2–3)
	RewardCoins = 100, -- โบนัสเหรียญตอนฝึกจบ
