-- ⚠️ ลำดับ/ชื่อ Id ของขั้น ผูกกับโค้ด Server (TutorialService) — เปลี่ยนแค่ข้อความ/ตัวเลขได้เลย · เพิ่ม/ลบขั้นต้องแก้โค้ดด้วย

return table.freeze({
	Enabled = true, -- false = ปิดระบบฝึกทั้งหมด (ทุกคนถือว่าฝึกจบแล้ว) ใช้ตอนเทสอย่างอื่น

	-- ขั้นตอนตามลำดับ (เลขขั้น = ลำดับในตารางนี้ · ขั้นถัดจากตัวสุดท้าย = จบ)
	Steps = table.freeze({
		table.freeze({ Id = "ChooseElement", Text = "เลือกธาตุให้ป้อมของคุณ!" }),
		table.freeze({ Id = "WatchTurret", Text = "ป้อมของคุณยิงเองอัตโนมัติ — ดูมันจัดการมอน!" }),
		table.freeze({ Id = "UseSkill", Text = "กด Q (หรือปุ่มสกิล) ใช้สกิลธาตุ!" }),
		table.freeze({ Id = "Upgrade", Text = "ได้เงินจากมอนแล้ว — กด U อัปป้อมให้แรงขึ้น!" }),
		table.freeze({ Id = "MeetBoss", Text = "บอสยักษ์จะมาตรงนี้! ตีให้แรงที่สุด = ได้เงิน + อุปกรณ์ (กด G ดูอุปกรณ์)" }),
	}),

	WatchMonsters = 3, -- มอนฝึกขั้น 2 (เดินมาตามเลนผู้เล่นคนนั้นเท่านั้น)
	SkillMonsters = 2, -- มอนฝึกขั้น 3 (เป็นเป้าให้กดสกิล)
	TrainingMonsterHp = 20, -- เลือดมอนฝึก (อ่อนกว่ามอนปกติ ให้ตายเร็ว)
	TrainingSpawnGap = 1.2, -- วินาทีระหว่างมอนฝึกแต่ละตัว
